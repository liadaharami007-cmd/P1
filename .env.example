# העתק קובץ זה ל-.env ומלא את הערכים. לעולם אל תעלה את .env ל-GitHub.
# כל שורה ריקה = היכולת מוצגת במערכת כ"לא מחוברת" (לא מזויפת).

# ---- מנוע מודל (ניתוח AI, סיכום מנהלים) ----
# Gemini — מסלול חינמי (aistudio.google.com → Get API key). מספיק אחד מהמנועים.
GEMINI_API_KEY=
# P1_GEMINI_MODEL=            # ריק = בחירה אוטומטית של מודל Flash זמין
ANTHROPIC_API_KEY=
# P1_AI_ENGINE=auto            # auto | anthropic | ollama | rules
# P1_MODEL=claude-opus-5-5
# P1_OLLAMA_URL=http://localhost:11434   # מודל מקומי חינמי (Ollama)
# P1_OLLAMA_MODEL=qwen2.5:7b-instruct

# ---- שרת ----
# P1_PUBLIC_URL=https://app.example.com   # הכתובת הציבורית (קישורי איפוס, חנות הדמו)
# P1_COOKIE_SECURE=1                      # חובה בייצור (HTTPS)
# P1_ALLOW_SIGNUP=1
# P1_BOOTSTRAP_EMAIL=you@example.com     # בפריסה ציבורית: רק המייל הזה יכול להיות המשתמש הראשון (מנהל)
# P1_DB_PATH=data/p1.db
# P1_RUN_WORKER=1
# P1_MAX_CONCURRENT_AUDITS=2

# ---- תשלומים (Paddle — תומך בעסקים מישראל; התחילו ב-sandbox) ----
# P1_BILLING_PROVIDER=paddle
# PADDLE_ENV=sandbox
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
# PADDLE_PRICE_PRO_MONTHLY=
# PADDLE_PRICE_PRO_YEARLY=
# PADDLE_PRICE_AGENCY_MONTHLY=
# PADDLE_PRICE_AGENCY_YEARLY=

# ---- מייל (שחזור סיסמה) — כל שרת SMTP ----
# P1_SMTP_HOST=
# P1_SMTP_PORT=587
# P1_SMTP_USER=
# P1_SMTP_PASSWORD=
# P1_SMTP_FROM=P1 AI <no-reply@example.com>
